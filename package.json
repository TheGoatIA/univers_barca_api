{
  "name": "univers-barca-api",
  "version": "0.1.0",
  "description": "API Backend Univers Barça — Node.js 22, Express, TypeScript, MongoDB (Mongoose), Redis, BullMQ",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/export-swagger.ts",
    "start": "node dist/server.js",
    "start:prod": "pm2-runtime ecosystem.config.js --env production",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" \"**/*.{md,json,yml,yaml}\" --log-level warn",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" \"**/*.{md,json,yml,yaml}\" --log-level warn",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "test:security": "jest --config jest.config.js --selectProjects security --runInBand",
    "test:coverage": "jest --config jest.config.js --selectProjects unit --coverage",
    "test:all": "jest --config jest.config.js --runInBand --coverage",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "migrate:create": "migrate-mongo create",
    "seed": "tsx scripts/seed-data.ts",
    "export:swagger": "tsx scripts/export-swagger.ts",
    "check:swagger": "tsx scripts/export-swagger.ts --check",
    "licenses": "license-checker-rseidelsohn --production --markdown --out THIRD_PARTY_LICENSES.md",
    "prepare": "husky || true",
    "load:smoke": "sh scripts/run-load.sh smoke",
    "load:load": "sh scripts/run-load.sh load",
    "load:stress": "sh scripts/run-load.sh stress",
    "load:spike": "sh scripts/run-load.sh spike",
    "load:soak": "sh scripts/run-load.sh soak"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "migrate-mongo": "^14.0.7",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.11.3",
    "morgan": "^1.12.1",
    "nanoid": "^6.0.2",
    "node-cron": "^4.6.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^16.4.0",
    "mongodb": "^7.7.0",
    "pm2": "^7.0.4",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
