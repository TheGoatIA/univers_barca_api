# ───── Application ─────
NODE_ENV=development
PORT=5000
API_VERSION=v1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ───── MongoDB (replica set obligatoire, même en dev) ─────
MONGODB_URI=mongodb://localhost:27017/univers_barca?replicaSet=rs0

# ───── Redis (cache, blacklist JWT, rate limiting, BullMQ) ─────
REDIS_URL=redis://localhost:6379

# ───── JWT (générer des secrets d'au moins 32 caractères : openssl rand -base64 48) ─────
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars_xxxxxxxx
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars_xxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ───── Documentation & supervision ─────
SWAGGER_USER=docs
SWAGGER_PASSWORD=change_me_please_xxxxxxxx
METRICS_ALLOWED_IPS=127.0.0.1,::1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=univers-barca-api

# ───── Back-office : compte super-admin initial (script seed) ─────
ADMIN_BOOTSTRAP_EMAIL=admin@univers-barca.app
ADMIN_BOOTSTRAP_PASSWORD=change_me_please_xxxxxxxx

# ───── Services externes (placeholders — jamais de vraie valeur dans le dépôt) ─────
FOOTBALL_API_KEY=your_token_here
AI_TEXT_API_KEY=your_token_here
AI_IMAGE_API_KEY=your_token_here
FCM_SERVICE_ACCOUNT_BASE64=your_token_here
SLACK_WEBHOOK_URL=
